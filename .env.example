# Copie para .env.local e preencha: cp .env.example .env.local

# Backend do LogBuster (FastAPI), em execução local (chamado pelo navegador)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# true usa mocks locais na camada de reviews; false chama o backend configurado acima.
NEXT_PUBLIC_USE_API_MOCKS=false
