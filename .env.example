# Copie para .env.local e preencha: cp .env.example .env.local
# Chave gratuita em https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=
NEXT_PUBLIC_OMDB_BASE_URL=https://www.omdbapi.com
# Backend do LogBuster (FastAPI), em execução local
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# true usa mocks; false chama o backend configurado acima.
NEXT_PUBLIC_USE_API_MOCKS=true
